CHANNEL_HISTORY_TTL_S = 90   # 90s sliding window for cross-party follow-ups
ANAPHORA_FOLLOWUP_PAT = re.compile(
    r"\b(that|those|this|it|them|he|she|they|there|at\s+that\s+point|for\s+me|for\s+that|instead|what\s+about|how\s+about|and\s+what|then|also|too|wait|no|actually|meant|same)\b",
    re.I,
)


def get_recent_speaker_turns(channel_id: str, speaker_name: str = "", speaker_id: str = "") -> list[dict]:
    """Return up to the last 3 Q&A turns by this speaker (10m) plus immediate prior channel turn (90s)."""
    p = os.environ.get("VOICE_SPEAKER_HISTORY_PATH", SPEAKER_HISTORY_PATH)
    now_s = time.time()
    try:
        items = json.load(open(p, encoding="utf-8")) if os.path.exists(p) else []
    except Exception:
        items = []
    ckey = channel_id or "default"
    ukey = speaker_id or (speaker_name.lower() if speaker_name else "")
    valid = [e for e in items if isinstance(e, dict) and now_s - float(e.get("ts", 0)) <= SPEAKER_HISTORY_TTL_S]
    own = [e for e in valid if ukey and e.get("ukey") == ukey][-3:]
    other = [e for e in valid if e.get("ch") == ckey and e not in own and now_s - float(e.get("ts", 0)) <= CHANNEL_HISTORY_TTL_S][-1:]
    return sorted(other + own, key=lambda x: float(x.get("ts", 0)))[-3:]


def record_speaker_turn(channel_id: str, speaker_name: str, speaker_id: str, question: str, answer: str):
    """Persist a completed Q&A turn into the sliding speaker memory buffer."""
    p = os.environ.get("VOICE_SPEAKER_HISTORY_PATH", SPEAKER_HISTORY_PATH)
    now_s = time.time()
    clean_q = re.sub(rf"^\s*(?:hey[\s,]+)?{WAKE_PAT}[\s,!.?]*", "", question or "", flags=re.I).strip()
    clean_q = re.sub(r"\s*\[Follow-up to previous question:.*\]$", "", clean_q).strip()
    if not clean_q or not answer:
        return
    try:
        items = json.load(open(p, encoding="utf-8")) if os.path.exists(p) else []
    except Exception:
        items = []
    valid = [e for e in items if isinstance(e, dict) and now_s - float(e.get("ts", 0)) <= SPEAKER_HISTORY_TTL_S]
    valid.append({
        "ts": now_s,
        "ch": channel_id or "default",
        "ukey": speaker_id or (speaker_name.lower() if speaker_name else "anon"),
        "speaker": speaker_name or "Player",
        "q": clean_q[:220],
        "a": answer[:280],
    })
    try:
        tmp = p + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(valid[-25:], f)
        os.replace(tmp, p)
    except OSError:
        pass


def update_discord_roster(channel_id: str, speaker_name: str, speaker_id: str = "") -> list[str]:
    """Track active Discord voice participants seen in this channel over the last 30 minutes."""
    now_s = time.time()
    ckey = channel_id or "default"
    data = {}
    try:
        if os.path.exists(DISCORD_ROSTER_PATH):
            data = json.load(open(DISCORD_ROSTER_PATH, encoding="utf-8"))
    except Exception:
        data = {}
    ch = {k: v for k, v in (data.get(ckey) or {}).items() if isinstance(v, dict) and now_s - float(v.get("ts", 0)) <= 1800}
    if speaker_name:
        ukey = speaker_id or speaker_name.lower()
        ch[ukey] = {"name": speaker_name, "ts": now_s}
        data[ckey] = ch
        try:
            with open(DISCORD_ROSTER_PATH, "w", encoding="utf-8") as f:
                json.dump(data, f)
        except OSError:
            pass
    return [v["name"] for v in sorted(ch.values(), key=lambda x: -float(x.get("ts", 0))) if v.get("name")]


def format_party_context(speaker_name: str = "", speaker_id: str = "", channel_id: str = "") -> str:
    st = load_party_state()
    bits = []
    discord_names = update_discord_roster(channel_id, speaker_name, speaker_id)
    if discord_names:
        bits.append("Active Discord voice speakers: " + ", ".join(discord_names[:8]))
    pkey = speaker_id or (speaker_name.lower() if speaker_name else "")
    players = st.get("players") or {}
    sp_info = players.get(pkey) or (next((v for v in players.values() if v.get("name", "").lower() == speaker_name.lower()), None) if speaker_name else None)
    if speaker_name and sp_info and sp_info.get("summary"):
        bits.append(f"Current speaker: {speaker_name} ({sp_info['summary']})")
    elif speaker_name:
        bits.append(f"Current speaker: {speaker_name}")
    elif sp_info and sp_info.get("summary"):
        bits.append(f"Current speaker character: {sp_info['summary']}")
    other_roster = [f"{v.get('name', k)}: {v.get('summary')}" for k, v in players.items() if v.get("summary") and v is not sp_info]
    if other_roster:
        bits.append("Party roster: " + "; ".join(other_roster[:5]))
    # Live telemetry from AlfredBridge WoW Forever addon (if active within last 2h)
    live_map = st.get("live") or {}
    now_s = time.time()
    for lk, lv in list(live_map.items())[:4]:
        if not isinstance(lv, dict):
            continue
        if lv.get("ts_epoch") and now_s - float(lv["ts_epoch"]) > 7200:
            continue
        loc = f"{lv.get('subzone')}, {lv.get('zone')}" if lv.get("subzone") and lv.get("subzone") != lv.get("zone") else (lv.get("zone") or "")
        coord_s = f" ({lv['x']:.1f}, {lv['y']:.1f})" if isinstance(lv.get("x"), (int, float)) and isinstance(lv.get("y"), (int, float)) else ""
        tgt_s = f" | Target: {lv['target']}" if lv.get("target") else ""
        q_s = f" | Active quests: {', '.join(lv['quests'][:3])}" if lv.get("quests") else ""
        bits.append(f"Live in-game bridge ({lv.get('name') or lk} -> {lv.get('char', 'Player')} Lvl {lv.get('level', '?')} {str(lv.get('class', '')).title()}): {loc}{coord_s}{tgt_s}{q_s}")
        if lv.get("party"):
            p_str = "; ".join(f"{pm.get('n')} (Lvl {pm.get('l')} {str(pm.get('c', '')).title()} in {pm.get('z', '?')})" for pm in lv["party"][:4] if isinstance(pm, dict))
            if p_str:
                bits.append(f"Live party1..4 members: {p_str}")
    party = st.get("party") or {}
    if party.get("goal"):
        bits.append(f"Active party zone/goal: {party['goal']}")
    notes = st.get("notes") or []
    if notes:
        bits.append("Pinned party notes: " + " | ".join(f"#{n.get('id')} ({n.get('by', 'Party')}): {n.get('text')}" for n in notes[-5:]))
    recent_turns = get_recent_speaker_turns(channel_id, speaker_name, speaker_id)
    if recent_turns:
        now_s = time.time()
        t_lines = [
            f"  * {t.get('speaker', 'Player')} ({max(1, int(now_s - float(t.get('ts', now_s))))}s ago): \"{t.get('q', '')}\" -> Alfred: \"{t.get('a', '')}\""
            for t in recent_turns
        ]
        bits.append("Recent conversation history (resolve pronouns/follow-ups like 'at that point' or 'for me' from this speaker's prior turns):\n" + "\n".join(t_lines))
    return "\n".join(bits)


def enrich_query_with_bridge(text: str, speaker_name: str = "", speaker_id: str = "") -> str:
    """Append live zone / target hints for DB lookup when player omits zone or asks about 'this guy' / 'my target'."""
    st = load_party_state()
    live_map = st.get("live") or {}
    if not live_map:
        return text
    pkey = speaker_id or (speaker_name.lower() if speaker_name else "")
    lv = live_map.get(pkey) or next((v for v in live_map.values() if isinstance(v, dict)), None)
    if not isinstance(lv, dict) or (lv.get("ts_epoch") and time.time() - float(lv["ts_epoch"]) > 7200):
        return text
    extras = []
    if lv.get("target") and re.search(r"\b(target|this\s+(?:guy|npc|mob|woman|man|dwarf|elf|orc)|talking\s+to|in\s+front\s+of\s+me)\b", text, re.I):
        extras.append(str(lv["target"]))
    if lv.get("zone"):
        try:
            import wow_db
            q_low = text.lower()
            if not any(z.lower() in q_low for z in wow_db.KNOWN_ZONES) and not any(t in q_low for t in wow_db.TOWN_TO_ZONE):
                extras.append(str(lv["zone"]))
        except Exception:
            pass
    return f"{text} ({' '.join(extras)})" if extras else text


def handle_party_command(text: str, speaker_name: str = "", speaker_id: str = "", channel_id: str = "") -> tuple[str, int] | None:
    """Fast $0 deterministic handler for shared party blackboard (character profile, party zone/goal, pins/notes)."""
    t0 = time.perf_counter()
    clean = re.sub(rf"^\s*(?:hey[\s,]+)?{WAKE_PAT}[\s,!.?]*", "", text, flags=re.I).strip().rstrip(".")
    if not clean:
        return None
    who = speaker_name or "sir"
    pkey = speaker_id or (speaker_name.lower() if speaker_name else "default")

    # 0. Who is in Discord / my party?
    if re.search(r"\b(?:who(?:'?s|\s+is|\s+are)\s+(?:currently\s+)?(?:in\s+)?(?:my\s+|the\s+|our\s+)?(?:\w+\s+)?(?:party|group|discord|voice(?:\s+channel)?|chat|call|here)|(?:can\s+you\s+see|do\s+you\s+(?:see|have))\s+(?:the\s+|our\s+|my\s+)?party\s+telemetry)\b", clean, re.I):
        st = load_party_state()
        discord_names = update_discord_roster(channel_id, speaker_name, speaker_id)
        now_s = time.time()
        wow_members = []
        for lv in (st.get("live") or {}).values():
            if not isinstance(lv, dict) or (lv.get("ts_epoch") and now_s - float(lv["ts_epoch"]) > 7200):
                continue
            if lv.get("char"):
                wow_members.append(f"{lv['char']} (Lvl {lv.get('level', '?')} {str(lv.get('class', '')).title()} in {lv.get('zone', '?')})")
            for pm in (lv.get("party") or [])[:4]:
                if isinstance(pm, dict) and pm.get("n"):
                    wow_members.append(f"{pm['n']} (Lvl {pm.get('l', '?')} {str(pm.get('c', '')).title()} in {pm.get('z', '?')})")
        saved = [f"{v.get('name', k)} ({v['summary']})" for k, v in (st.get("players") or {}).items() if isinstance(v, dict) and v.get("summary")]
        parts = []
        if discord_names:
            parts.append(f"In Discord voice I have heard {', '.join(discord_names[:8])}.")
        if wow_members:
            parts.append(f"In your WoW party I see {', '.join(wow_members[:5])}.")
        elif saved:
            parts.append(f"Saved party roster: {', '.join(saved[:5])}.")
        else:
            parts.append("I do not have live WoW party telemetry synced yet—make sure the AlfredBridge relay is running on your PC.")
        return " ".join(parts), round((time.perf_counter() - t0) * 1000)

    # 1. Clear notes
    m_clr = re.search(r"\b(?:clear|delete|wipe|remove)\s+(?:all\s+)?(?:our\s+|the\s+|my\s+|party\s+)?(?:notes?|pins?|party\s+board)(?:\s+(?:number\s+|#)?(\d+))?\b", clean, re.I)
    if m_clr:
        st = load_party_state()
        nid = int(m_clr.group(1)) if m_clr.group(1) else None
        if nid is not None:
            before = len(st["notes"])
            st["notes"] = [n for n in st["notes"] if n.get("id") != nid]
            save_party_state(st)
            msg = f"Removed note number {nid} from the party board, {who}." if len(st["notes"]) < before else f"I did not find note number {nid} on the board, {who}."
        else:
            st["notes"] = []
            save_party_state(st)
            msg = f"Cleared all pinned notes from the party board, {who}."
        return msg, round((time.perf_counter() - t0) * 1000)

    # 2. Read back board / notes / roster
    if re.search(r"\b(?:read\s+back\s+(?:our\s+|the\s+|my\s+)?(?:notes?|pins?|party\s+board|reminders?)|what(?:'s|\s+is|\s+do\s+we\s+have)\s+on\s+(?:our\s+|the\s+)?(?:party\s+board|notes?|pins?)|what\s+(?:party\s+)?notes?\s+do\s+we\s+have|read\s+(?:our\s+|the\s+)?party\s+board)\b", clean, re.I):
        st = load_party_state()
        parts = []
        if st.get("party", {}).get("goal"):
            parts.append(f"Your party objective is {st['party']['goal']}.")
        notes = st.get("notes") or []
        if notes:
            parts.append("Pinned notes: " + "; ".join(f"number {n['id']} from {n.get('by', 'the party')}, {n['text']}" for n in notes[-5:]) + ".")
        else:
            parts.append("There are currently no pinned notes on the party board.")
        return " ".join(parts), round((time.perf_counter() - t0) * 1000)

    # 3. Set party zone / goal ("remember we're in Duskwood tonight" / "set party zone to ...")
    m_party = re.match(r"^(?:please\s+)?(?:remember\s+(?:that\s+)?(?:we(?:'re|\s+are)|the\s+party\s+is)\s+|(?P<verb>set|update)\s+(?:our\s+|the\s+)?party\s+(?:zone|goal|objective|location)\s+(?:to|as)\s+)(.+)$", clean, re.I)
    if m_party:
        goal = m_party.group(2).strip()
        if not m_party.group("verb"):
            goal = f"currently {goal}"
        st = load_party_state()
        st["party"] = {"goal": goal[:160], "updated_ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "by": speaker_name or "Player"}
        save_party_state(st)
        return f"Noted, {who}. I have updated the party board to {goal}.", round((time.perf_counter() - t0) * 1000)

    # 4. Set speaker character ("remember I'm a level 22 Human Paladin" / "set my character to ...")
    m_char = re.match(r"^(?:please\s+)?(?:remember\s+(?:that\s+)?i(?:'m|\s+am)\s+(?:playing\s+)?|(?:set|update|save)\s+my\s+(?:character|class|spec|profile)\s+(?:to|as)\s+)(?:a\s+|an\s+)?(.+)$", clean, re.I)
    if m_char:
        desc = m_char.group(1).strip()[:140]
        st = load_party_state()
        st["players"][pkey] = {"name": speaker_name or "Player", "summary": desc, "updated_ts": time.strftime("%Y-%m-%dT%H:%M:%S")}
        save_party_state(st)
        return f"Very good, {who}. I have you down as {desc}.", round((time.perf_counter() - t0) * 1000)

    # 5. Add note / pin / reminder ("take a note ...", "pin 37.5, 50.7 as ...", "remind us to ...")
    m_note = re.match(r"^(?:please\s+)?(?:(?:take|save|jot(?:\s+down)?|add|leave)\s+a\s+(?:party\s+)?note(?:\s+that)?[\s,:]*|pin\s+(?:waypoint\s+|coords?\s+|coordinates?\s+)?|remind\s+(?:us|me|the\s+party)\s+(?:to\s+|that\s+|about\s+)?)(.+)$", clean, re.I)
    if m_note:
        note_txt = m_note.group(1).strip()[:200]
        if note_txt:
            st = load_party_state()
            next_id = (max((n.get("id", 0) for n in st["notes"]), default=0) + 1)
            st["notes"].append({"id": next_id, "ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "by": speaker_name or "Player", "text": note_txt})
            st["notes"] = st["notes"][-20:]
            save_party_state(st)
            return f"Pinned note number {next_id} to the party board, {who}: {note_txt}.", round((time.perf_counter() - t0) * 1000)

    return None


def handle_feature_request(text: str) -> tuple[str, str, int]:
    """Summarize and persist a spoken feature request to feature-requests.jsonl and backlog.md."""
    t0 = time.perf_counter()
    clean_idea = re.sub(rf"^\s*(?:hey[\s,]+)?{WAKE_PAT}[\s,!.?]*", "", text, flags=re.I).strip()
    summary = clean_idea
    t_sys = (
        "Summarize the spoken Discord voice feature request for Alfred into a concise 1-line engineering ticket title (maximum 12 words). "
        "Output ONLY the plain title text, no quotes or punctuation."
    )
    t_msgs = (
        [{"role": "user", "content": f"{t_sys}\n\nSPOKEN REQUEST: {clean_idea}\nTITLE:"}]
        if "alfred-v1" in LOCAL_FAST_MODEL
        else [{"role": "system", "content": t_sys}, {"role": "user", "content": f"SPOKEN REQUEST: {clean_idea}\nTITLE:"}]
    )
    try:
        req = urllib.request.Request(
            OLLAMA_CHAT_URL,
            data=json.dumps({
                "model": LOCAL_FAST_MODEL,
                "messages": t_msgs,
                "stream": False,
                "think": False,
                "keep_alive": "2h",
                "options": {"num_predict": 35, "temperature": 0.1},
            }).encode("utf-8"),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=2.5) as r:
            _d = json.loads(r.read().decode("utf-8")); _LAST_TOKENS.update({"in_tok": _d.get("prompt_eval_count", 0), "out_tok": _d.get("eval_count", 0)}); ans = re.sub(r"^.*?SPOKEN (?:REPLY|ANSWER):\s*", "", _d.get("message", {}).get("content", ""), flags=re.S).strip().strip('"')
            if ans:
                summary = ans.splitlines()[0].strip()
    except Exception:
        pass

    ms = round((time.perf_counter() - t0) * 1000)
    ts = time.strftime("%Y-%m-%dT%H:%M:%S")
    req_id = 1
    try:
        os.makedirs(os.path.dirname(FEATURE_LOG_PATH), exist_ok=True)
        if os.path.exists(FEATURE_LOG_PATH):
            req_id = sum(1 for l in open(FEATURE_LOG_PATH) if l.strip()) + 1
        entry = {"id": req_id, "ts": ts, "raw_voice": text, "summary": summary, "status": "open"}
        with open(FEATURE_LOG_PATH, "a") as f:
            f.write(json.dumps(entry) + "\n")
        if os.path.exists(BACKLOG_PATH):
            with open(BACKLOG_PATH, "a") as bf:
                bf.write(f"\n- [ ] **[VOICE-REQ-#{req_id}] ({ts[:10]}):** {summary} *(raw: \"{clean_idea}\")*\n")
    except OSError:
        pass

    spoken = f"Very good, sir. I have logged feature request number {req_id} in the host's backlog and posted the ticket to bot commands."
    return spoken, summary, ms


def call_local_fast_butler(question: str, ctx: str, timeout: float = 9.0) -> tuple[str | None, int]:
    """Call the warm local model (alfred-v2) on Sheldon RTX 2080 (:11434) with Verify-Then-Escalate guards."""
    t0 = time.perf_counter()
    is_lore_q = bool(re.search(r"\b(lore|history|story|origin|origins|background|describe|explain|tell\s+(?:me|us)\s+(?:a\s+little\s+bit\s+)?about)\b", question, re.I)) and not bool(re.search(r"\b(where|closest|nearest|repair|vendor|buy|sell|trainer|train|coords|coordinates|location)\b", question, re.I))
    raw_rows = ctx.splitlines()[1:]
    filtered = [r[:340] for r in raw_rows if is_lore_q or not r.startswith("- Lore (")]
    if not filtered:
        filtered = [r[:340] for r in raw_rows]
    facts = "\n".join(filtered[:6])  # top 6 compact rows (<280 tokens -> ~600ms on RTX 2080)
    sys_msg = (
        "You are Alfred, a calm, understated, matter-of-fact British butler helping friends in Discord voice on World of Warcraft: Forever. "
        "Answer in 1 or 2 short spoken sentences (maximum 35 words) using ONLY the verified facts provided. "
        "Address them as 'sir' once if natural. Plain spoken English only — never read quest ID numbers (#123) or markdown, "
        "and ALWAYS include exact NPC-bound coordinates (e.g. 55.6, 59.8) when answering where an NPC, object, or turn-in is located. "
        "If [OUTSIDE ...] appears on the matching row, include the compass direction from town. "
        "If the provided facts do not directly and completely answer the question, output exactly: ESCALATE"
    )
    user_msg = f"VERIFIED WOW FACTS:\n{facts}\n\nPLAYER QUESTION: <voice_transcript>{question}</voice_transcript>\nSPOKEN ANSWER:"
    msgs = (
        [{"role": "user", "content": f"{sys_msg}\n\n{user_msg}"}]
        if "alfred-v1" in LOCAL_FAST_MODEL
        else [{"role": "system", "content": sys_msg}, {"role": "user", "content": user_msg}]
    )
    payload = {
        "model": LOCAL_FAST_MODEL,
        "messages": msgs,
        "stream": False,
        "think": False,
        "keep_alive": "2h",
        "options": {"num_predict": 85, "temperature": 0.2},
    }
    try:
        req = urllib.request.Request(
            OLLAMA_CHAT_URL,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = json.loads(r.read().decode("utf-8")); _LAST_TOKENS.update({"in_tok": data.get("prompt_eval_count", 0), "out_tok": data.get("eval_count", 0)})
        ans = data.get("message", {}).get("content", "").strip().strip('"')
        ms = round((time.perf_counter() - t0) * 1000)
        return (ans if local_answer_ok(question, facts, ans) else None), ms
    except Exception:
        return None, round((time.perf_counter() - t0) * 1000)


def local_answer_ok(question: str, facts: str, ans: str) -> bool:
    """Verify-then-escalate: reject local answers that dodge, omit coordinates, borrow lore/landmark/other-NPC coords, or name the wrong role."""
    if not ans or "ESCALATE" in ans.upper() or UNCERTAIN_REPLY.search(ans) or len(ans) > 420:
        return False
    entity_lines = [l for l in facts.splitlines() if not l.lstrip("- ").startswith(("Lore (", "Landmark ("))]
    entity_blob = "\n".join(entity_lines)
    if re.search(r"\b(where|closest|nearest|located|location|coordinates|coords|grab|pick\s+up)\b", question, re.I) and re.search(r"\(\d+\.\d+,\s*\d+\.\d+\)", entity_blob) and not re.search(r"\b\d{1,2}(?:\.\d+)?\s*,\s*\d{1,2}(?:\.\d+)?\b", ans):
        return False
    # Every spoken coordinate must be an NPC/object/quest's own position (never a Lore dungeon entrance or town-hub Landmark coordinate).
    own = set(re.findall(r"\|[^|\[\]]*?\((\d+\.\d+),\s*(\d+\.\d+)\)", entity_blob))
    spoken_coords = re.findall(r"(\d{1,2}\.\d)\s*,\s*(\d{1,2}\.\d)", ans)
    if any((x, y) not in own for x, y in spoken_coords):
        return False
    # If the answer explicitly names an NPC from facts, every spoken coordinate must appear on one of the named NPCs' rows,
    # and for non-service queries the named NPC must match a word from the question or a matching quest row (rejects FTS mob collisions like Shorestalker for Southshore).
    service_q = bool(re.search(r"\b(vendor|repair|trainer|inn(?:keeper)?|flight|gryphon|wyvern|hippogryph|arrows?|bullets?|ammo|bowyer|buy|sell)\b", question, re.I))
    named_npc_rows = [l for l in entity_lines for m in [re.search(r"NPC:\s*([^<|(#]+)", l)] if m and m.group(1).strip().lower() in ans.lower()]
    if spoken_coords and named_npc_rows:
        npc_own = set(re.findall(r"\|[^|\[\]]*?\((\d+\.\d+),\s*(\d+\.\d+)\)", "\n".join(named_npc_rows)))
        if any((x, y) not in npc_own for x, y in spoken_coords):
            return False
    if named_npc_rows and not service_q:
        q_low = question.lower()
