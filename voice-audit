#!/usr/bin/env python3
"""Pretty-print the Discord voice audit log: voice-audit [N] | --woke [N] | --corrections | --features."""
import collections, json, os, sys

AUDIT_LOG = os.environ.get("VOICE_AUDIT_LOG", os.path.expanduser("~/.openclaw/logs/voice-audit.jsonl"))
CORRECTIONS_LOG = os.environ.get("VOICE_CORRECTIONS_LOG", os.path.expanduser("~/.openclaw/logs/corrections.jsonl"))
FEATURE_LOG = os.environ.get("VOICE_FEATURE_LOG", os.path.expanduser("~/.openclaw/logs/feature-requests.jsonl"))

ARM_LABELS = {
    "LOCAL_SIMPLE_GEMMA4": "Gemma 4 E2B (Local WoW, $0)",
    "LOCAL_BANTER_GEMMA4": "Gemma 4 E2B (Local Banter, $0)",
    "A_LOCAL_GEMMA4":      "Gemma 4 E2B (Local A/B, $0)",
    "COMPLEX_GEMINI":      "Gemini 3.5 Flash (~$0.00035)",
    "B_CLOUD_GEMINI":      "Gemini 3.5 Flash (A/B, ~$0.00035)",
    "A_ESCALATED_GEMINI":  "Gemini 3.5 Flash (Escalated)",
    "OPENCLAW_MINIMAX":    "MiniMax-M2.7 (OpenClaw Tools)",
    "B_CLOUD_MINIMAX":     "MiniMax-M2.7 (Cloud A/B)",
    "A_ESCALATED_CLOUD":   "MiniMax-M2.7 (Escalated)",
}

if "--features" in sys.argv:
    if not os.path.exists(FEATURE_LOG):
        print("No voice feature requests logged yet.")
        sys.exit(0)
    for l in open(FEATURE_LOG, encoding="utf-8").read().splitlines():
        if not l.strip():
            continue
        f = json.loads(l)
        print(f"[#{f.get('id')} | {f.get('ts')} | {f.get('status')}] {f.get('summary')}\n  Raw: {f.get('raw_voice')}\n")
    sys.exit(0)

if "--corrections" in sys.argv:
    if not os.path.exists(CORRECTIONS_LOG):
        print("No corrections logged yet.")
        sys.exit(0)
    for l in open(CORRECTIONS_LOG, encoding="utf-8").read().splitlines():
        if not l.strip():
            continue
        c = json.loads(l)
        print(f"[{c['ts']}]\n  Q:     {c.get('question', '')}\n  WRONG: {c.get('wrong_answer', '')}\n  USER:  {c.get('user_correction', '')}\n  FIXED: {c.get('corrected_answer', '')}\n")
    sys.exit(0)

args = [a for a in sys.argv[1:] if a not in ("--woke", "-w", "--routes")]
woke_only = any(a in ("--woke", "-w", "--routes") for a in sys.argv[1:])
n = int(args[0]) if args and args[0].isdigit() else (20 if woke_only else 30)

lines = [json.loads(l) for l in open(AUDIT_LOG, encoding="utf-8").read().splitlines() if l.strip()]

if woke_only:
    turns = []
    counts = collections.Counter()
    for i, r in enumerate(lines):
        if r.get("kind") == "stt" and r.get("woke"):
            arm = r.get("arm") or "OPENCLAW_MINIMAX"
            counts[arm] += 1
            tts = ""
            for j in range(i + 1, min(i + 8, len(lines))):
                if lines[j].get("kind") == "tts":
                    tts = lines[j].get("spoken") or lines[j].get("raw") or ""
                    break
                if lines[j].get("kind") == "stt" and lines[j].get("woke"):
                    break
            turns.append((r, arm, tts))
    print("=== ALFRED VOICE ROUTING SUMMARY (ALL LOGGED WOKE TURNS) ===")
    for arm, cnt in counts.most_common():
        print(f"  {cnt:3d}x  {arm:<22} -> {ARM_LABELS.get(arm, arm)}")
    print(f"\n=== LAST {min(n, len(turns))} WOKE QUESTIONS & ANSWERS ===")
    for r, arm, tts in turns[-n:]:
        label = ARM_LABELS.get(arm, arm)
        llm_ms = f"{r['local_ms']}ms" if r.get("local_ms") else "gateway"
        in_t = r.get("in_tok") or (145 if "BANTER" in arm else (880 if "GEMINI" in arm else 18500))
        out_t = r.get("out_tok") or max(1, round(len(tts) / 3.8))
        cost_str = f"${(in_t * 0.30 + out_t * 2.50) / 1e6:.5f}" if "GEMINI" in arm else "$0.00000"
        print(f"[{r['ts']}]  {label} | STT: {r.get('ms')}ms | LLM: {llm_ms} | Tokens: {in_t} in / {out_t} out ({cost_str}) | DB: {r.get('db_rows', 0)} rows")
        print(f"  Q: {r.get('text', '')}")
        print(f"  A: {tts or '(no spoken reply)'}\n")
    sys.exit(0)

for r in lines[-n:]:
    if r["kind"] == "stt":
        icon = "\u23f9" if r.get("interrupt") else ("\u2714" if r.get("woke") else "\u00b7")
        arm_tag = f" [{r['arm']}" + (f" {r['local_ms']}ms]" if r.get("local_ms") else "]") if r.get("arm") else ""
        db_tag = (f" [+{r['db_rows']} DB]" if r.get("db_rows") else (" [INTERRUPT]" if r.get("interrupt") else "")) + arm_tag
        print(f"{r['ts']}  HEARD {icon} ({r.get('ms')}ms){db_tag}: {r['text']}")
    else:
        ctag = " [CORRECTION LOGGED]" if r.get("corrected") else ""
        print(f"{r['ts']}  SPOKE{ctag}: {r['spoken']}")
        if r.get("raw") != r.get("spoken"):
            print(f"{' ' * 21}raw:  {r.get('raw')}")
