def is_casual_or_random(text: str, ctx: str, db_rows: int) -> bool:
    """Route casual greetings, real-life/off-topic questions, and non-WoW remarks to Local Gemma 4 E2B ($0)."""
    stripped = re.sub(rf"^\s*(?:hey[\s,]+)?{WAKE_PAT}[\s,!.?]*", "", text, flags=re.I).strip()
    if CHAT_CONTEXT_PAT.search(stripped):
        return False
    if CASUAL_BANTER_PAT.search(stripped):
        return True
    if "[Follow-up to previous question:" in text or WOW_SIGNAL_PAT.search(stripped) or "- Landmark (" in ctx:
        return False
    # Check if any known WoW zone or town is in the query, or if 1+ distinct proper-noun query words match a top retrieved WoW NPC/Quest/Item
    try:
        import wow_db
        q_low = stripped.lower()
        if any(z.lower() in q_low for z in wow_db.KNOWN_ZONES) or any(t in q_low for t in wow_db.TOWN_TO_ZONE):
            return False
    except Exception:
        pass
    if len(stripped.split()) <= 2:
        return True
    stop = {"what", "where", "when", "which", "there", "about", "tell", "little", "have", "this", "that", "with", "from", "your", "should", "would", "could", "long", "friend", "does", "give", "plain", "english", "found", "right", "check", "better", "nothing", "literally", "warned", "standards", "trying", "pretty", "actually", "think", "thought", "going", "gonna"}
    q_stems = {w[:5] for w in re.findall(r"[a-z0-9]+", stripped.lower()) if len(w) >= 4 and w not in stop}
    for line in ctx.splitlines()[1:6]:
        head = line.split("|")[0].lower()
        if sum(1 for s in q_stems if s in head) >= 1 and not line.startswith("- Lore ("):
            return False
        if sum(1 for s in q_stems if s in head) >= 2:
            return False
    return True


def call_local_sassy_banter(question: str, timeout: float = 9.0, speaker: str = "", party_ctx: str = "") -> tuple[str | None, int]:
    """Handle random banter/chatter on warm local alfred-v2 (:11434) with dry, sassy British butler wit."""
    t0 = time.perf_counter()
    p_lbl = f"Player ({speaker})" if speaker else "Player"
    ctx_note = f"\nActive party & Discord context:\n{party_ctx}" if party_ctx else ""
    sys_msg = (
        "You are Alfred, a deadpan, dry-witted British butler (like Michael Caine's Alfred Pennyworth) hanging out in Discord voice while the boys play World of Warcraft: Forever. "
        "Reply in 1 or 2 short, conversational spoken sentences (under 25 words). "
        "If asked a real-world question, give a genuinely useful, accurate answer first, followed by a light, dry tease. "
        "If someone throws banter, slang, or nonsense at you, do not take it literally and never say 'Very well' or 'Certainly, master'. "
        "Push back with effortless, understated dry wit (never cheesy villain insults like 'imbecile' or 'whelp'). Never output map coordinates."
        f"{ctx_note}"
    )
    if "alfred-v1" in LOCAL_FAST_MODEL:
        msgs = [{"role": "user", "content": (
            f"{sys_msg}\n\n"
            "Player: Hey, Alfred, what is up, brother?\n"
            "Alfred: Just watching you gentlemen pull half the zone again, sir. Truly a masterclass in tactical restraint.\n\n"
            "Player: Hey Alfred, how long do I put pizza rolls in the air fryer?\n"
            "Alfred: Eight minutes at 380 degrees, sir, and do let them cool for thirty seconds so you don't blister the roof of your mouth again.\n\n"
            f"{p_lbl}: {question}\nAlfred:"
        )}]
    else:
        msgs = [
            {"role": "system", "content": sys_msg},
            {"role": "user", "content": f"{p_lbl}: {question}\nAlfred:"},
        ]
    payload = {
        "model": LOCAL_FAST_MODEL,
        "messages": msgs,
        "stream": False,
        "think": False,
        "keep_alive": "2h",
        "options": {"num_predict": 60, "temperature": 0.55},
    }
    try:
        req = urllib.request.Request(OLLAMA_CHAT_URL, data=json.dumps(payload).encode("utf-8"), headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            _d = json.loads(r.read().decode("utf-8")); _LAST_TOKENS.update({"in_tok": _d.get("prompt_eval_count", 0), "out_tok": _d.get("eval_count", 0)}); ans = re.sub(r"^.*?SPOKEN (?:REPLY|ANSWER):\s*", "", _d.get("message", {}).get("content", ""), flags=re.S).strip().strip('"')
        return (ans if ans else None), round((time.perf_counter() - t0) * 1000)
    except Exception:
        return None, round((time.perf_counter() - t0) * 1000)


