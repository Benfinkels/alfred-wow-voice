def estimate_difficulty(text: str, ctx: str, db_rows: int) -> float:
    """ATLAS 3-Signal Difficulty Estimator: D(x) = 0.40*(1 - s_p) + 0.30*(1 - r_c) + 0.30*q_c in [0, 1]."""
    if db_rows <= 0 or not ctx:
        return 1.0
    words = text.split()
    has_broad = bool(
        COMPLEX_QUERY.search(text)
        or re.search(r"\b(should\s+(?:i|we)\s+(?:level|skip|go|do|leave|pick)|skip|best|order|directions|landmarks|tips|build|fastest|next|why|how\s+do\s+we\s+get|relative\s+to|more\s+specific|unabridged|wipe)\b", text, re.I)
    )
    q_c = min(1.0, (len(words) / 22.0) * 0.5 + (0.8 if has_broad else 0.0))
    top_blob = "\n".join(ctx.splitlines()[1:6]).lower()
    stop = {"alfred", "where", "which", "there", "about", "quest", "quests", "level", "should", "nearest", "closest"}
    q_toks = [w[:5] for w in re.findall(r"[a-z0-9]+", text.lower()) if len(w) >= 4 and w not in stop]
    r_c = sum(1 for t in q_toks if t in top_blob) / max(1, len(q_toks))
    s_p = 1.0 if (NARROW_LOOKUP_PAT.search(text) or re.search(r"\b(fishing\s+level|train\s+for|drop\s+rate)\b", text, re.I)) else 0.0
    return 0.40 * (1.0 - s_p) + 0.30 * (1.0 - r_c) + 0.30 * q_c


