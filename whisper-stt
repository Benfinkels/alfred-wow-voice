DIRECT_HEY_WAKE = re.compile(rf"\bhey[\s,]+{WAKE_PAT}[\s,!.?]+(?:where|what|who|how|when|why|can|could|would|will|give|tell|find|show|post|send|log|is|are|do|does)\b", re.I)


def strip_pre_wake(text: str) -> str:
    m = None
    for m in DIRECT_HEY_WAKE.finditer(text):
        pass
    return text[m.start():].strip() if m else text


def classify(text: str, playing: bool = False) -> str:
    if INTERRUPT.search(text):
        return "INTERRUPT"
    if WAKE.search(text) and SELF_CANCEL.search(text):
        return "INTERRUPT"
    if BARE_INTERRUPT.search(text) and playing:
        return "BARE_INTERRUPT"
    if DIRECT_HEY_WAKE.search(text):
        return "WAKE"
    woke = bool(WAKE.search(text)) and not bool(NON_QUESTION.search(text)) and not bool(THIRD_PERSON.search(text))
    return "WAKE" if woke else "IGNORE"


