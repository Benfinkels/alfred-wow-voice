def is_simple_wow_lookup(text: str, ctx: str, db_rows: int) -> bool:
    """Route to the local model for narrow "where is / who sells / what drops" lookups that ATLAS D(x) scores below 0.75.
    alfred-v1 (Gemma 4 7.5B) scored 10/10 on narrow lookups vs Gemma 4 E2B 6/10 (2026-11-08 bench).
    "what level" / "what do I do with" / "how do I", cross-zone travel ("from X to Y"), follow-up corrections, or pushback/beta queries stay on Gemini."""
    return (
        bool(NARROW_LOOKUP_PAT.search(text))
        and not PUSHBACK_OR_BETA_PAT.search(text)
        and "[Follow-up to previous question:" not in text
        and not re.search(r"\b(what\s+level|what\s+do\s+i\s+do\s+with|how\s+do\s+(?:i|we)|where\s+does\s+.*?\s+spawn|running\s+from|from\s+\w+(?:\s+\w+)?\s+to\s+\w+|between\s+\w+(?:\s+\w+)?\s+and\s+\w+)\b", text, re.I)
        and estimate_difficulty(text, ctx, db_rows) < 0.75
    )


