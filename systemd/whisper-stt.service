[Unit]
Description=faster-whisper STT daemon for OpenClaw Discord Voice
After=network.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=0
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=%h/.venvs/whisper/bin/python3 %h/bin/whisper_daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
