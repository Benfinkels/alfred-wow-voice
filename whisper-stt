    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.2)
        s.connect(CTRL_SOCK)
        s.sendall((cmd + "\n").encode())
        return json.loads(s.makefile().readline()).get("playing", False)
    except Exception:
        return False


