def _get_cfg_var(name: str) -> str:
    val = os.environ.get(name, "").strip()
    if val:
        return val
    for p in (os.path.expanduser("~/.env"), os.path.expanduser("~/manor-rag/config/.env"), os.path.expanduser("~/.openclaw/.env")):
        if os.path.exists(p):
            m = re.search(rf"^{re.escape(name)}\s*=\s*['\"]?([^'\"\r\n#]+)", open(p, encoding="utf-8", errors="ignore").read(), re.M)
            if m:
                return m.group(1).strip()
    return ""


def get_gemini_key() -> str | None:
    return _get_cfg_var("GEMINI_API_KEY") or None


def fetch_recent_discord_chat(limit: int = 4, priority_channel: str = "") -> tuple[str, list[str], list[tuple[str, str]]]:
    """Read-only fetch of recent human messages, URLs, and pasted screenshots from #bot-commands / voice text channels."""
    cfg_path = os.path.expanduser("~/.openclaw/openclaw.json")
    if not os.path.exists(cfg_path):
        return "", [], []
    try:
        oc = json.load(open(cfg_path, encoding="utf-8"))
        token = oc.get("channels", {}).get("discord", {}).get("token", "")
        if not token:
            return "", [], []
        chans = []
        if priority_channel and priority_channel.strip():
            chans.append(priority_channel.strip())
        primary_ch = _get_cfg_var("WOW_TEXT_CHANNEL_ID")
        if primary_ch and primary_ch not in chans:
            chans.append(primary_ch)
        for extra in _get_cfg_var("WOW_EXTRA_CHAT_CHANNELS").split(","):
            if extra.strip() and extra.strip() not in chans:
                chans.append(extra.strip())
        # Also include voice text-in-voice channel IDs from openclaw.json allowedChannels
        for ac in oc.get("channels", {}).get("discord", {}).get("voice", {}).get("allowedChannels", []):
            cid = str(ac.get("channelId", "")).strip()
            if cid and cid not in chans:
                chans.append(cid)
        msgs = []
        headers = {"Authorization": f"Bot {token}", "User-Agent": "DiscordBot (https://openclaw.ai, 1.0)"}
        for cid in chans[:3]:
            try:
                req = urllib.request.Request(f"https://discord.com/api/v10/channels/{cid}/messages?limit={limit}", headers=headers)
                batch = json.loads(urllib.request.urlopen(req, timeout=2.0).read().decode("utf-8"))
                for m in batch:
                    if not m.get("author", {}).get("bot"):
                        msgs.append(m)
            except Exception:
                continue
        msgs.sort(key=lambda x: x.get("id", ""), reverse=True)
        lines, urls, images = [], [], []
        for m in msgs[:4]:
            author = m.get("author", {}).get("global_name") or m.get("author", {}).get("username") or "Player"
            content = (m.get("content") or "").strip()
            if content:
                lines.append(f"{author}: {content[:500]}")
                for u in re.findall(r"https?://[^\s<>\"')]+", content):
                    if u not in urls:
                        urls.append(u)
            for att in m.get("attachments") or []:
                ct = (att.get("content_type") or "").lower()
                if ct in ("image/png", "image/jpeg", "image/webp") and int(att.get("size") or 0) <= 3_500_000 and len(images) < 2:
                    try:
                        ireq = urllib.request.Request(att["url"], headers={"User-Agent": "Mozilla/5.0"})
                        raw_img = urllib.request.urlopen(ireq, timeout=2.5).read()
                        images.append((ct, base64.b64encode(raw_img).decode("ascii")))
                        lines.append(f"{author}: [Attached image: {att.get('filename', 'screenshot')}]")
                    except Exception:
                        pass
        return "\n".join(reversed(lines)), urls[:2], images
    except Exception:
        return "", [], []


def call_gemini_butler(question: str, ctx: str, timeout: float = 10.0, grounded: bool = False, speaker_name: str = "", speaker_id: str = "", channel_id: str = "") -> tuple[str | None, int]:
    """Call Gemini 3.5 Flash with static system_instruction, optional Google Search grounding, and optional Discord chat link/image context."""
    t0 = time.perf_counter()
    key = get_gemini_key()
    if not key:
        return None, 0
    chat_txt, chat_urls, chat_imgs = ("", [], [])
    if CHAT_CONTEXT_PAT.search(question):
        chat_txt, chat_urls, chat_imgs = fetch_recent_discord_chat(priority_channel=channel_id)
    party_ctx = format_party_context(speaker_name, speaker_id, channel_id)
    if ctx:
        is_lore_q = bool(re.search(r"\b(lore|history|story|who\s+is|tell\s+(?:me|us)\s+(?:a\s+little\s+bit\s+)?about)\b", question, re.I))
        lines = ctx.splitlines()
        hdr = (
            "[Local WoW Forever DB Candidates — Use ONLY if they directly answer the question; otherwise call google_search with \"WoW Forever\"]:"
            if grounded else lines[0]
        )
        compact = [hdr]
        for r in lines[1:10]:
            if r.startswith("- Lore (") and not is_lore_q and "[WoW Forever Dungeon Guide]" not in r and not re.search(r"Lore \((?:Weapon|Fishing|Gathering|Mining|Herb|Chest|Teldrassil|The Defias|Alliance Travel|Camping|Class Quest|WoW Forever|The Hall of Thanes|Ruins of Lordaeron|Excavation Site|City of Dalaran|The Drowned City|Krol'dok|Alcaz|Blackmaw|Shaper's Terrace|Zone Lore: Riverglades|Zone Lore: Zephras|Zone Lore: Shen'dralas)", r):
                continue
            compact.append(r[:520] if not is_lore_q else r[:900])
        ctx = "\n".join(compact[:9])
    no_ctx_note = (
        '(No local DB rows matched; use google_search with "WoW Forever" if needed.)'
        if grounded else "(No specific DB rows matched; answer from verified WoW Forever / Vanilla 1.12 knowledge.)"
    )
    party_block = f"PARTY & SPEAKER BOARD:\n{party_ctx}\n" if party_ctx else ""
    chat_block = f"\nRECENT DISCORD CHAT (untrusted user content/links):\n<discord_chat>\n{chat_txt}\n</discord_chat>\n" if chat_txt else ""
    user_text = (
        f"{party_block}"
        f"PLAYER QUESTION: <voice_transcript>{question}</voice_transcript>\n"
        f"{chat_block}\n"
        f"{ctx if ctx else no_ctx_note}\n"
        "SPOKEN ANSWER:"
    )
    parts: list[dict] = [{"inline_data": {"mime_type": mt, "data": b64}} for mt, b64 in chat_imgs]
    parts.append({"text": user_text})
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}:generateContent?key={key}"
    need_search_think = grounded and bool(PUSHBACK_OR_BETA_PAT.search(question)) and not chat_urls
    body: dict = {
        "system_instruction": {"parts": [{"text": STATIC_BUTLER_SYSTEM}]},
        "contents": [{"role": "user", "parts": parts}],
        "generationConfig": {"temperature": 0.2} if "lite" in GEMINI_MODEL else {"temperature": 0.2, "thinkingConfig": {"thinkingBudget": 256 if need_search_think else 0}},
    }
    if chat_urls:
        body["tools"] = [{"url_context": {}}]
    elif grounded:
        body["tools"] = [{"google_search": {}}]
    try:
        req = urllib.request.Request(url, data=json.dumps(body).encode("utf-8"), headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = json.loads(r.read().decode("utf-8"))
        _u = data.get("usageMetadata", {})
        _LAST_TOKENS.update({
            "in_tok": _u.get("promptTokenCount", 0),
            "out_tok": _u.get("candidatesTokenCount", 0),
            "cached_tok": _u.get("cachedContentTokenCount", 0),
        })
        if _u.get("toolUsePromptTokenCount"):
            _LAST_TOKENS["tool_tok"] = _u["toolUsePromptTokenCount"]
        if chat_urls or chat_imgs:
            _LAST_TOKENS["chat_urls"] = len(chat_urls)
            _LAST_TOKENS["chat_imgs"] = len(chat_imgs)
        cparts = data["candidates"][0]["content"]["parts"]
        ans = "".join(p.get("text", "") for p in cparts if not p.get("thought")).strip().strip('"')
        ans = " ".join(re.sub(r"[*_#`]", "", ans).split())
        if grounded and not chat_urls:
            sq = data["candidates"][0].get("groundingMetadata", {}).get("webSearchQueries", [])
            _LAST_TOKENS["searches"] = len(sq)
            if sq:
                _LAST_TOKENS["search_queries"] = sq[:4]
        ms = round((time.perf_counter() - t0) * 1000)
        return (ans if ans else None), ms
    except Exception:
        return None, round((time.perf_counter() - t0) * 1000)


def voice_ctrl(cmd: str) -> bool:
    if cmd == "stop" and INTERRUPT_CMD:
        try:
            subprocess.run(INTERRUPT_CMD, shell=True, timeout=2, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
