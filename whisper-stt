def is_casual_or_random(text: str, ctx: str, db_rows: int) -> bool:
    """Route casual greetings, real-life/off-topic questions, and non-WoW remarks to Local Gemma 4 E2B ($0)."""
    stripped = re.sub(rf"^\s*(?:hey[\s,]+)?{WAKE_PAT}[\s,!.?]*", "", text, flags=re.I).strip()
    if CASUAL_BANTER_PAT.search(stripped):
        return True
    if WOW_SIGNAL_PAT.search(stripped) or "- Landmark (" in ctx:
        return False
    # Check if any known WoW zone or town is in the query, or if 2+ distinct query words match a single WoW entity
    try:
        import wow_db
        q_low = stripped.lower()
        if any(z.lower() in q_low for z in wow_db.KNOWN_ZONES) or any(t in q_low for t in wow_db.TOWN_TO_ZONE):
            return False
    except Exception:
        pass
    if len(stripped.split()) <= 2:
        return True
    q_stems = {w[:5] for w in re.findall(r"[a-z0-9]+", stripped.lower()) if len(w) >= 4 and w not in {"what", "where", "when", "which", "there", "about", "tell", "little", "have", "this", "that", "with", "from", "your", "should", "would", "could", "long"}}
    for line in ctx.splitlines()[1:4]:
        head = line.split("|")[0].lower()
        if sum(1 for s in q_stems if s in head) >= 2:
            return False
    return True


