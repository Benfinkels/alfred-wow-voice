[Unit]
Description=Kokoro-82M ONNX TTS daemon (GTX 1080 CUDA) for OpenClaw Discord Voice
After=network.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/bin/bash -c 'export LD_LIBRARY_PATH=$(echo %h/.openclaw/venv/lib/python*/site-packages/nvidia/*/lib | tr " " ":"); exec %h/.openclaw/venv/bin/python3 %h/bin/kokoro_daemon.py'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
